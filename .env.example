# Model (server-only)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=8000

# Evidence, suppression and approvals (server-only secret key; never ship to a browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
WIZER_COMPANY_ID=

# Outreach policy: copy outreach.policy.example.json, fill in your real legal identity and per-country rules
OUTREACH_POLICY_FILE=outreach.policy.json

# Where previews are published: supabase (Storage bucket) or local (a directory you serve yourself)
SITE_HOST=local
SITE_HOST_BUCKET=demo-previews
SITE_HOST_DIR=.wizer/previews
SITE_PUBLIC_BASE_URL=https://previews.example

# How outreach leaves the building: dry_run (writes files) or resend (sends email)
OUTREACH_CHANNEL=dry_run
OUTREACH_DIR=.wizer/outbox
RESEND_API_KEY=
OUTREACH_FROM=

# Discovery and probing. Put a real contact URL in the user agent so people you probe can reach you.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
PROBE_USER_AGENT=WizerPresenceBot/0.1 (+https://example.com/bot)
PROBE_TIMEOUT_MS=10000
PROBE_MIN_HOST_INTERVAL_MS=1500
